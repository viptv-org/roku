<?xml version="1.0" encoding="utf-8"?>
<component name="RemotePassword" extends="Group">
 <interface>
  <field id="serverAllowed" type="boolean" value="true" onChange="paint" />
  <field id="username" type="string" onChange="paint" />
  <field id="password" type="string" onChange="paint" />
  <field id="busy" type="boolean" value="false" onChange="paint" />
  <field id="error" type="string" alias="errorLabel.text" />
  <field id="submitted" type="boolean" alwaysNotify="true" />
  <field id="cancelled" type="boolean" alwaysNotify="true" />
  <field id="serverRequested" type="boolean" alwaysNotify="true" />
  <function name="resetForm" />
  <function name="focusKeyboard" />
 </interface>
 <script type="text/brightscript" uri="pkg:/source/RemoteWire.brs" />
 <script type="text/brightscript" uri="pkg:/components/remote/RemotePassword.brs" />
 <children>
  <Rectangle width="1920" height="1080" color="#0B0B0C" />
  <Label translation="[96,96]" width="1130" height="35" text="Use a password" color="#8F8D89"><Font role="font" uri="pkg:/fonts/remote_onest_600.ttf" size="24" /></Label>
  <RemoteTrackedLabel translation="[96,137.8]" text="Sign in with your password" size="52" tracking="-1.04" />
  <Group id="fields" translation="[96,230]" />
  <RemoteKeyboard id="input" translation="[96,540]" entryMode="true" maxLength="320" />
  <Group id="buttons" translation="[1290,270]" />
  <Label translation="[1290,458]" width="534" height="70" wrap="true" numLines="2" lineSpacing="6" text="Typing with a remote is slow. Scanning a code with your phone is quicker." color="#B6B4AF"><Font role="font" uri="pkg:/fonts/remote_onest_400.ttf" size="22" /></Label>
  <Label id="errorLabel" translation="[1290,716]" width="534" height="120" wrap="true" maxLines="3" color="#F87171"><Font role="font" uri="pkg:/fonts/remote_onest_400.ttf" size="22" /></Label>
  <Label id="busyLabel" translation="[1290,844]" width="534" height="36" text="Signing in…" visible="false" color="#B6B4AF"><Font role="font" uri="pkg:/fonts/remote_onest_400.ttf" size="22" /></Label>
 </children>
</component>
