<?xml version="1.0" encoding="utf-8"?>
<component name="RemoteFormDialog" extends="Group">
 <interface>
  <field id="purpose" type="string" onChange="render" />
  <field id="text" type="string" onChange="render" />
  <field id="busy" type="boolean" onChange="render" />
  <field id="error" type="string" onChange="render" />
  <field id="focusIndex" type="integer" value="0" onChange="render" />
  <field id="submitted" type="boolean" alwaysNotify="true" />
  <field id="cancelled" type="boolean" alwaysNotify="true" />
  <field id="editRequested" type="boolean" alwaysNotify="true" />
 </interface>
 <script type="text/brightscript" uri="pkg:/components/remote/RemoteFormDialog.brs" />
 <children>
  <Rectangle width="1920" height="1080" color="#00000099" />
  <Label id="measure" visible="false" text="Ag"><Font role="font" uri="pkg:/fonts/remote_onest_400.ttf" size="14" /></Label>
  <Group id="panel">
   <Poster id="ground" uri="pkg:/images/design/remote-form-dialog.9.png" blendColor="#212124" />
   <RemoteTrackedLabel id="title" translation="[24,24]" weight="400" size="24" tracking="0" />
   <Poster id="outline" translation="[24,80]" height="56" />
   <Rectangle id="labelGround" color="#212124" />
   <Label id="label" color="#F4F2EE"><Font role="font" uri="pkg:/fonts/remote_onest_400.ttf" size="12" /></Label>
   <Label id="value" translation="[40,98]" height="20" color="#F4F2EE"><Font role="font" uri="pkg:/fonts/remote_onest_400.ttf" size="14" /></Label>
   <Label id="failure" translation="[24,150]" color="#F87171" wrap="true"><Font role="font" uri="pkg:/fonts/remote_onest_400.ttf" size="14" /></Label>
   <Group id="cancel">
    <Poster id="cancelFocus" width="70" height="40" uri="pkg:/images/design/remote-form-button.9.png" blendColor="#363638" />
    <RemoteTrackedLabel id="cancelText" text="Cancel" weight="500" size="14" tracking="0.1" rowWidth="70" rowHeight="40" />
   </Group>
   <Group id="confirm">
    <Poster id="confirmFocus" height="40" uri="pkg:/images/design/remote-form-button.9.png" blendColor="#363638" />
    <RemoteTrackedLabel id="confirmText" weight="500" size="14" tracking="0.1" rowHeight="40" />
   </Group>
  </Group>
 </children>
</component>
